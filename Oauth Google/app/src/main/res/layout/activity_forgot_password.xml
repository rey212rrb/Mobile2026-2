<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_primary">
    <View android:id="@+id/accent_bar" android:layout_width="0dp" android:layout_height="3dp" android:background="@color/google_yellow" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <ImageButton android:id="@+id/btn_back" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_arrow_back" android:background="?attr/selectableItemBackgroundBorderless" android:tint="@color/text_primary" android:contentDescription="Volver" android:layout_marginTop="16dp" android:layout_marginStart="16dp" app:layout_constraintTop_toBottomOf="@id/accent_bar" app:layout_constraintStart_toStartOf="parent"/>
    <!--  Icon  -->
    <ImageView android:id="@+id/iv_icon" android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_lock_reset" android:tint="@color/google_yellow" android:contentDescription="Recuperar contraseña" android:layout_marginTop="24dp" android:layout_marginStart="24dp" app:layout_constraintTop_toBottomOf="@id/btn_back" app:layout_constraintStart_toStartOf="parent"/>
    <TextView android:id="@+id/tv_title" android:layout_width="0dp" android:layout_height="wrap_content" android:text="¿Olvidaste tu contraseña?" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginTop="16dp" android:layout_marginHorizontal="24dp" app:layout_constraintTop_toBottomOf="@id/iv_icon" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/tv_subtitle" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Elige cómo quieres recuperar el acceso a tu cuenta" android:textSize="14sp" android:textColor="@color/text_secondary" android:lineSpacingMultiplier="1.4" android:layout_marginTop="8dp" android:layout_marginHorizontal="24dp" app:layout_constraintTop_toBottomOf="@id/tv_title" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <!--  Option 1: Google  -->
    <androidx.cardview.widget.CardView android:id="@+id/card_google_option" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginTop="28dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/card_bg" app:layout_constraintTop_toBottomOf="@id/tv_subtitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:id="@+id/option_google" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="18dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_circle_blue">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_google_logo" android:layout_gravity="center" android:contentDescription="Google"/>
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginHorizontal="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Verificar con Google" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inicia sesión con Google para restablecer tu contraseña" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_marginTop="2dp" android:lineSpacingMultiplier="1.3"/>
            </LinearLayout>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" android:tint="@color/text_secondary" android:contentDescription="Siguiente"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <!--  Option 2: Email  -->
    <androidx.cardview.widget.CardView android:id="@+id/card_email_option" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginTop="12dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/card_bg" app:layout_constraintTop_toBottomOf="@id/card_google_option" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:id="@+id/option_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="18dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_circle_yellow">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_email" android:tint="@color/google_yellow" android:layout_gravity="center" android:contentDescription="Email"/>
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginHorizontal="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Enviar email de recuperación" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Recibirás un enlace para crear una nueva contraseña" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_marginTop="2dp" android:lineSpacingMultiplier="1.3"/>
            </LinearLayout>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" android:tint="@color/text_secondary" android:contentDescription="Siguiente"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <!--  Email input (hidden by default)  -->
    <LinearLayout android:id="@+id/ll_email_form" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginHorizontal="20dp" android:layout_marginTop="16dp" android:visibility="gone" app:layout_constraintTop_toBottomOf="@id/card_email_option" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_email" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeColor="@color/input_stroke">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ingresa tu correo electrónico" android:inputType="textEmailAddress" android:textColor="@color/text_primary" android:textSize="15sp"/>
        </com.google.android.material.textfield.TextInputLayout>
        <Button android:id="@+id/btn_send_email" android:layout_width="match_parent" android:layout_height="52dp" android:text="Enviar enlace de recuperación" android:textSize="14sp" android:textColor="@android:color/white" android:backgroundTint="@color/google_yellow" android:layout_marginTop="12dp" app:cornerRadius="12dp"/>
    </LinearLayout>
    <!--  Success state (hidden by default)  -->
    <LinearLayout android:id="@+id/ll_success" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginHorizontal="20dp" android:layout_marginTop="32dp" android:visibility="gone" app:layout_constraintTop_toBottomOf="@id/card_email_option" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_check_circle" android:tint="@color/google_green" android:contentDescription="Éxito"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="¡Correo enviado!" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginTop="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/tv_success_detail" android:text="Revisa tu bandeja de entrada y sigue las instrucciones" android:textSize="14sp" android:textColor="@color/text_secondary" android:textAlignment="center" android:layout_marginTop="6dp" android:lineSpacingMultiplier="1.4"/>
    </LinearLayout>
    <!--  Loading overlay  -->
    <FrameLayout android:id="@+id/loading_overlay" android:layout_width="0dp" android:layout_height="0dp" android:background="#80000000" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ProgressBar android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:indeterminateTint="@android:color/white"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>