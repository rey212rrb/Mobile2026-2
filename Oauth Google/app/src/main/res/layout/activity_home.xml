<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_primary">
    <!--  Top bar  -->
    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar" android:layout_width="0dp" android:layout_height="?attr/actionBarSize" android:background="@color/card_bg" android:elevation="2dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mi Cuenta" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
        <ImageButton android:id="@+id/btn_logout" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_logout" android:background="?attr/selectableItemBackgroundBorderless" android:tint="@color/text_secondary" android:contentDescription="Cerrar sesión" android:layout_gravity="end" android:layout_marginEnd="8dp"/>
    </androidx.appcompat.widget.Toolbar>
    <!--  Profile card  -->
    <androidx.cardview.widget.CardView android:id="@+id/card_profile" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginTop="24dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/card_bg" app:layout_constraintTop_toBottomOf="@id/toolbar" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:gravity="center">
            <!--  Avatar  -->
            <com.google.android.material.imageview.ShapeableImageView android:id="@+id/iv_avatar" android:layout_width="80dp" android:layout_height="80dp" android:src="@drawable/ic_default_avatar" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/CircleImageView" android:layout_marginBottom="12dp"/>
            <!--  Badge: Google Connected  -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_badge_google" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:layout_marginBottom="14dp">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_google_logo" android:layout_marginEnd="5dp" android:contentDescription="Google"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Conectado con Google" android:textSize="11sp" android:textColor="@color/google_blue"/>
            </LinearLayout>
            <TextView android:id="@+id/tv_user_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nombre del usuario" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
            <TextView android:id="@+id/tv_user_email" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="usuario@gmail.com" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_marginTop="4dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <!--  Info rows card  -->
    <androidx.cardview.widget.CardView android:id="@+id/card_info" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginTop="16dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/card_bg" app:layout_constraintTop_toBottomOf="@id/card_profile" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="8dp">
            <!--  Auth method row  -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_shield" android:tint="@color/google_blue" android:contentDescription="Auth"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Método de autenticación" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_marginStart="14dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Google OAuth" android:textSize="13sp" android:textColor="@color/text_secondary"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/divider" android:layout_marginHorizontal="20dp"/>
            <!--  Token row  -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_key" android:tint="@color/google_yellow" android:contentDescription="Token"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Estado del token" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_marginStart="14dp"/>
                <TextView android:id="@+id/tv_token_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Activo" android:textSize="13sp" android:textColor="@color/google_green"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/divider" android:layout_marginHorizontal="20dp"/>
            <!--  Last login  -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_clock" android:tint="@color/text_secondary" android:contentDescription="Fecha"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Último acceso" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_marginStart="14dp"/>
                <TextView android:id="@+id/tv_last_login" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ahora" android:textSize="13sp" android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <!--  Actions card  -->
    <androidx.cardview.widget.CardView android:id="@+id/card_actions" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginTop="16dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/card_bg" app:layout_constraintTop_toBottomOf="@id/card_info" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <!--  Change password  -->
            <Button android:id="@+id/btn_change_password" android:layout_width="match_parent" android:layout_height="50dp" android:text="Cambiar contraseña" android:textSize="14sp" android:textColor="@color/google_blue" app:cornerRadius="12dp" app:strokeColor="@color/google_blue" app:strokeWidth="1dp" android:backgroundTint="@android:color/transparent" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <!--  Logout  -->
            <Button android:id="@+id/btn_logout_main" android:layout_width="match_parent" android:layout_height="50dp" android:text="Cerrar sesión" android:textSize="14sp" android:textColor="@color/text_primary" app:cornerRadius="12dp" app:strokeColor="@color/divider" app:strokeWidth="1dp" android:backgroundTint="@android:color/transparent" android:layout_marginTop="10dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <!--  Delete account  -->
            <Button android:id="@+id/btn_delete_account" android:layout_width="match_parent" android:layout_height="50dp" android:text="Eliminar cuenta" android:textSize="14sp" android:textColor="@color/google_red" app:cornerRadius="12dp" app:strokeColor="@color/google_red" app:strokeWidth="1dp" android:backgroundTint="@android:color/transparent" android:layout_marginTop="10dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
